{
  "name": "@texo-ui/data-adapter",
  "version": "0.1.0",
  "description": "Bring-your-own-storage drivers for Texo: local, Google Drive, Notion, HTTP.",
  "keywords": [
    "byos",
    "storage",
    "google-drive",
    "notion",
    "localstorage",
    "texo"
  ],
  "license": "MIT",
  "author": "Youngjune Kwon",
  "homepage": "https://github.com/WinM2M/texo-ui#readme",
  "bugs": {
    "url": "https://github.com/WinM2M/texo-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WinM2M/texo-ui.git",
    "directory": "packages/data-adapter"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --tsconfig tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

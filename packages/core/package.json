{
  "name": "@texo-ui/core",
  "version": "0.1.0",
  "description": "Stream-first parser that turns LLM text into a UI tree. Platform independent.",
  "keywords": [
    "llm",
    "streaming",
    "parser",
    "generative-ui",
    "markdown",
    "ast",
    "texo"
  ],
  "license": "MIT",
  "author": "Youngjune Kwon",
  "homepage": "https://github.com/WinM2M/texo-ui#readme",
  "bugs": {
    "url": "https://github.com/WinM2M/texo-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WinM2M/texo-ui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --tsconfig tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
  "publishConfig": {
    "access": "public"
  }
}

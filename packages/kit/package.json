{
  "name": "@texo-ui/kit",
  "version": "0.1.0",
  "description": "The built-in Texo component vocabulary, plus the catalog that teaches it to an LLM.",
  "keywords": [
    "llm",
    "generative-ui",
    "react",
    "components",
    "design-system",
    "texo"
  ],
  "license": "MIT",
  "author": "Youngjune Kwon",
  "homepage": "https://github.com/WinM2M/texo-ui#readme",
  "bugs": {
    "url": "https://github.com/WinM2M/texo-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WinM2M/texo-ui.git",
    "directory": "packages/kit"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --tsconfig tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@texo-ui/react": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

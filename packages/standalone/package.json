{
  "name": "@texo-ui/standalone",
  "version": "0.1.0",
  "description": "Texo in one script tag. Self-contained bundle for CDN and no-build pages.",
  "keywords": [
    "llm",
    "generative-ui",
    "cdn",
    "no-build",
    "widget",
    "texo"
  ],
  "license": "MIT",
  "author": "Youngjune Kwon",
  "homepage": "https://github.com/WinM2M/texo-ui#readme",
  "bugs": {
    "url": "https://github.com/WinM2M/texo-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WinM2M/texo-ui.git",
    "directory": "packages/standalone"
  },
  "type": "module",
  "main": "dist/texo.umd.cjs",
  "module": "dist/texo.iife.js",
  "browser": "dist/texo.iife.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/texo.iife.js",
  "jsdelivr": "dist/texo.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/texo.iife.js",
      "require": "./dist/texo.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.types.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@texo-ui/core": "^0.1.0",
    "@texo-ui/react": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@texo-ui/kit": "^0.1.0"
  }
}
